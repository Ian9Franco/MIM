{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@mim/contracts-core": ["./packages/contracts-core/index.ts"],
      "@mim/contracts-core/*": ["./packages/contracts-core/*"],
      "@mim/network-resilience": ["./packages/network-resilience/index.ts"],
      "@mim/network-resilience/*": ["./packages/network-resilience/*"],
      "@mim/server-engine": ["./packages/server-engine/index.ts"],
      "@mim/server-engine/*": ["./packages/server-engine/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "web"]
}
