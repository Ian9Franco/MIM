{
  "name": "temp_next",
  "version": "7.5.0",
  "private": true,
  "main": "standalone/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:standalone": "next build && node standalone/prepare.js",
    "start:standalone": "electron standalone/main.js",
    "package:win": "npm run build:standalone && electron-builder build --win",
    "release": "node scripts/release.js",
    "version:sync": "node scripts/release.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "chalk": "^4.1.2",
    "chokidar": "^4.0.3",
    "idb": "^8.0.3",
    "inquirer": "^8.2.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mim.app",
    "productName": "MIM",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "standalone/main.js",
      "standalone/prepare.js",
      "standalone/scraper.js",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MIM"
    }
  }
}