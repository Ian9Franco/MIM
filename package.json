{
  "name": "mim",
  "version": "11.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ian9Franco/MIM.git"
  },
  "main": "standalone/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=9999",
    "test:nbt": "ts-node --project tsconfig.scripts.json scripts/__tests__/nbt-integration.test.ts",
    "test:api": "ts-node --project tsconfig.scripts.json scripts/__tests__/api-integration.test.ts",
    "eval:sage": "ts-node --project tsconfig.scripts.json scripts/evaluation/sage-eval.ts",
    "benchmark:aduana": "ts-node --project tsconfig.scripts.json scripts/benchmarks/aduana-benchmark.ts",
    "test": "node scripts/test-runner.js",
    "test:quick": "node scripts/test-runner.js",
    "lint:api-guard": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/security/verify-api-guard.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include=\"lib/modding/nbt.ts\" --include=\"lib/intelligence/sage/**\" node scripts/test-runner.js",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include=\"lib/modding/nbt.ts\" --include=\"lib/intelligence/sage/**\" node scripts/test-runner.js",
    "demo": "node scripts/demo-tour.js",
    "build:standalone": "next build && node standalone/prepare.js",
    "start:standalone": "electron standalone/main.js",
    "package:win": "npm run build:standalone && electron-builder build --win --publish never",
    "release": "node scripts/release.js",
    "version:sync": "node scripts/release.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "adm-zip": "^0.5.17",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "date-fns": "^4.3.0",
    "framer-motion": "^11.0.0",
    "idb": "^8.0.3",
    "inquirer": "^8.2.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "skinview3d": "^3.4.2",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "c8": "^12.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mim.app",
    "productName": "MIM",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "standalone/main.js",
      "standalone/prepare.js",
      "standalone/scraper.js",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MIM"
    }
  }
}