{
  "name": "mim",
  "version": "11.4.5",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Ian9Franco/MIM.git"
  },
  "main": "standalone/main.js",
  "workspaces": [
    "apps/*",
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:server-fixture": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/dev/server-audit-fixture.ts",
    "build": "next build",
    "build:hub": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:hub",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=471",
    "lint:hub": "eslint web/app web/components web/lib --max-warnings=100",
    "lint:all": "npm run lint && npm run lint:hub && npm run lint:architecture && npm run lint:api-guard",
    "test:nbt": "ts-node --project tsconfig.scripts.json scripts/__tests__/nbt-integration.test.ts",
    "test:api": "ts-node --project tsconfig.scripts.json scripts/__tests__/api-integration.test.ts",
    "test:architecture": "ts-node --project tsconfig.scripts.json scripts/__tests__/architecture-boundaries.test.ts",
    "test:sage-errors": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/sage-error-contract.test.ts",
    "test:sage-stream": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/sage-stream-contract.test.ts",
    "test:ai-provider": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/ai-provider-runtime.test.ts",
    "test:server": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-sftp-integration.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-manager-foundation.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-sftp-discovery.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-audit-api.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-preflight-snapshot.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-executor-rollback.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-sage-remote.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-admin-rcon.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/server-multiplayer-sync.test.ts",
    "test:network": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/network-policy-contract.test.ts && ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/__tests__/network-adapters.test.ts",
    "eval:sage": "ts-node --project tsconfig.scripts.json scripts/evaluation/sage-eval.ts",
    "benchmark:aduana": "ts-node --project tsconfig.scripts.json scripts/benchmarks/aduana-benchmark.ts",
    "test": "node scripts/test-runner.js",
    "test:quick": "node scripts/test-runner.js",
    "lint:api-guard": "ts-node -r tsconfig-paths/register --project tsconfig.scripts.json scripts/security/verify-api-guard.ts",
    "lint:architecture": "ts-node --project tsconfig.scripts.json scripts/architecture/verify-boundaries.ts",
    "arch:analyze": "ts-node --project tsconfig.scripts.json scripts/architecture/analyze-graph.ts",
    "pr:audit": "node scripts/workflow/review-pr.js audit",
    "gatekeeper": "node scripts/workflow/review-pr.js audit",
    "pr:gatekeeper": "node scripts/workflow/review-pr.js audit",
    "pr:review": "node scripts/workflow/review-pr.js",
    "pr:promote": "node scripts/workflow/review-pr.js promote",
    "pr:return": "node scripts/workflow/review-pr.js return",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include=\"lib/modding/nbt.ts\" --include=\"lib/intelligence/sage/**\" node scripts/test-runner.js",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include=\"lib/modding/nbt.ts\" --include=\"lib/intelligence/sage/**\" node scripts/test-runner.js",
    "demo": "node scripts/demo-tour.js",
    "build:standalone": "next build && node standalone/prepare.js",
    "start:standalone": "electron standalone/main.js",
    "package:win": "npm run build:standalone && electron-builder build --win --publish never",
    "release": "node scripts/release.js",
    "release:auto": "node scripts/release.js --auto",
    "version:sync": "node scripts/release.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.0",
    "adm-zip": "^0.5.17",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "date-fns": "^4.3.0",
    "framer-motion": "^11.0.0",
    "idb": "^8.0.3",
    "inquirer": "^8.2.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-window": "^2.2.7",
    "react-window-infinite-loader": "^2.0.1",
    "skinview3d": "^3.4.2",
    "ssh2": "^1.17.0",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@types/ssh2": "^1.15.6",
    "c8": "^12.0.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mim.app",
    "productName": "MIM",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "standalone/main.js",
      "standalone/secret-store.js",
      "standalone/prepare.js",
      "standalone/scraper.js",
      ".next/standalone/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MIM"
    }
  }
}
